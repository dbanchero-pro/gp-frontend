{
    "name": "gp-frontend",
    "version": "2025.12.22",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "quanam": "ng serve --configuration=quanam",
        "arce-beta": "ng serve --configuration=arce-beta",
        "beta": "ng serve --configuration=beta",
        "build": "ng build --aot --base-href=/contratos/",
        "watch": "ng build --watch --configuration development",
        "test": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox --code-coverage",
        "testCodex": "export CHROME_BIN=$(node -e \"console.log(require('puppeteer').executablePath())\") && ng test --watch=false --browsers=ChromeHeadlessNoSandbox --code-coverage",
        "testLocal": "ng test --browsers=ChromeHeadlessNoSandbox --code-coverage"
    },
    "private": true,
